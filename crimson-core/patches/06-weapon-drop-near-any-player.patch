Original bug 6: a Weapon drop turns into 100 points only near player 1. The fix converts it near any player.
--- a/decomp/1.9/crimsonland/crimsonland/bonus_try_spawn_on_kill.cpp
+++ b/decomp/1.9/crimsonland/crimsonland/bonus_try_spawn_on_kill.cpp
@@ -73,14 +73,18 @@
 
         entry = bonus_spawn_at_pos(pos);
         if (entry->bonus_id == BONUS_ID_WEAPON) {
-            float dx = pos->x - player_state_table[0].position.x;
-            float dy = pos->y - player_state_table[0].position.y;
+            int near_count = portable_preserve_bugs ? 1 : config_blob.player_count;
+            for (int near_index = 0; near_index < near_count; ++near_index) {
+            float dx = pos->x - player_state_table[near_index].position.x;
+            float dy = pos->y - player_state_table[near_index].position.y;
             float distance_sq = dx * dx;
             distance_sq += dy * dy;
             if ((float)sqrt(distance_sq) < 56.0f) {
                 entry->bonus_id = BONUS_ID_POINTS;
                 entry->time.amount = 100;
+                break;
             }
+            }
         }
 
         duplicate_count = 0;
