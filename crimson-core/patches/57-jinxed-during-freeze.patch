Original bug 57 (1.9.8 only): 1.9.8's Jinxed kills a creature while Freeze is active. The fix returns before the
kill during Freeze, as 1.9.93 does.
--- a/decomp/1.9/crimsonland/game/perks_update_effects.cpp
+++ b/decomp/1.9/crimsonland/game/perks_update_effects.cpp
@@ -216,6 +216,10 @@
     if (bonus_freeze_timer > 0.0f) {
         return;
     }
+#else
+    if (!portable_preserve_bugs && bonus_freeze_timer > 0.0f) {
+        return;
+    }
 #endif
 
     int creature_id = crt_rand() % (portable_preserve_bugs ? 0x17f : 0x180);
