--- a/decomp/1.9/crimsonland/crimsonland/player_take_damage.cpp
+++ b/decomp/1.9/crimsonland/crimsonland/player_take_damage.cpp
@@ -37,7 +37,9 @@
         return;
     }
 
-    unsigned char was_dead = player_state_table[0].health <= 0.0f;
+    // A one-player run's dormant second slot keeps reading player 1, as Python does.
+    int guard_index = portable_preserve_bugs || player_index >= config_blob.player_count ? 0 : player_index;
+    unsigned char was_dead = player_state_table[guard_index].health <= 0.0f;
     if (perk_count_get(perk_id_thick_skinned) != 0) {
         damage_scale = 0.666f;
     }
