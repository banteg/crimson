@@ -4,7 +4,10 @@
 static __inline float vec2_distance(const vec2f_t *lhs, const vec2f_t *rhs)
 {
     float dx = lhs->x - rhs->x;
+    // Outside either axis, the rounded distance cannot be inside the strict radius.
+    if (dx <= -45.0f || dx >= 45.0f) return 45.0f;
     float dy = lhs->y - rhs->y;
+    if (dy <= -45.0f || dy >= 45.0f) return 45.0f;
     float distance_sq = dx * dx;
     distance_sq += dy * dy;
     return (float)sqrt(distance_sq);
