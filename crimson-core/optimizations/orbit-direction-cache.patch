 #include "crimsonland_config_owner.h"
+
+// Allocation and splitting keep phase_seed in [0, 384). The cache contains only
+// derived math, so reset/seek needs no invalidation. Keep trig wide until the first multiply.
+struct optimization_orbit_trig { bool ready; double cosine; double sine; };
+static optimization_orbit_trig optimization_orbit_cache[384];
+static inline const optimization_orbit_trig &optimization_orbit(int seed, float phase)
+{
+    auto &entry = optimization_orbit_cache[seed];
+    if (!entry.ready) {
+        entry.cosine = cos(phase);
+        entry.sine = sin(phase);
+        entry.ready = true;
+    }
+    return entry;
+}
 
