+        segment_count = round_count;
+    }
+    if (segment_count > (int)(grim_vertex_capacity - 2)) {
+        segment_count = (int)(grim_vertex_capacity - 2);
+    }
     for (int segment = 0; segment <= segment_count; ++segment) {
