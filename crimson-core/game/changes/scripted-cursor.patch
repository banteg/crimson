A scripted run (a capture, a watched moment, scripted input) draws no cursor until its script moves it: the
desktop mouse never reaches it, and the cursor clamps to the screen wherever it is parked.
--- a/decomp/1.9/crimsonland/ui_render/ui_cursor_render.cpp
+++ b/decomp/1.9/crimsonland/ui_render/ui_cursor_render.cpp
@@ -20,6 +20,9 @@
 {
     ui_cursor_anim_timer += frame_dt;
     ui_cursor_pulse_phase += (frame_dt * 1.1f);
+    if (game_cursor_hidden()) {
+        return;
+    }
 
     grim_interface_ptr->grim_set_config_var(0x13, 5u);
     grim_interface_ptr->grim_set_config_var(0x14, 2u);
