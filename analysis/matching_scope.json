{
  "schema": 1,
  "default": "port",
  "scopes": {
    "port": {
      "description": "Game-owned Crimsonland and Grim2D engine logic that the port must reproduce. Embedded SDK, codec, and compiler-runtime code is excluded.",
      "programs": {
        "crimsonland.exe": [
          {
            "start": "0x00401000",
            "end": "0x00452EF0",
            "owner": "game"
          }
        ],
        "grim.dll": [
          {
            "start": "0x10001000",
            "end": "0x1000A8D0",
            "owner": "grim-engine"
          }
        ]
      }
    }
  }
}
