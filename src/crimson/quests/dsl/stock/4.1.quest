quest "Major Alien Breach" version 1
weapon rocket_minigun
terrain (6, 7, 6)

# A hundred pairs from the east and north, each gap 15ms shorter than the last.
var cue = 4s
repeat 100 as i:
    at cue:
        burst template.alien_random_green_20 at edge("east") copies 2
        burst template.alien_random_green_20 at edge("north") copies 2
    cue += 2s - i * 15ms
