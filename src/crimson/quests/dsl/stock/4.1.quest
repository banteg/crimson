quest "Major Alien Breach" version 1
order native
counts native
weapon rocket_minigun
terrain (6, 7, 6)

var edges = edge_points()
var trigger = 4000
for offset in range(0, 1500, 15):
    at trigger:
        burst template.alien_random_green_20 at edges.right copies 2
    at trigger:
        burst template.alien_random_green_20 at edges.top copies 2
    trigger += 2000 - offset
    if trigger < 1000:
        trigger = 1000
