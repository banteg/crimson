quest "The Unblitzkrieg" version 1
terrain (6, 6, 7)

# Nests trace the square between 200 and 824 clockwise, twice, alternating alien and lizard
# and picking up pace; a centre nest lands as the first lap turns north.
let corners_cw = [point(824, 200), point(824, 824), point(200, 824), point(200, 200)]
let headings = [point(0, 1), point(-1, 0), point(0, -1), point(1, 0)]
let gaps = [1800ms, 1500ms, 1200ms, 800ms, 800ms, 700ms, 700ms, 800ms]
var cue = 500ms
repeat 8 as leg:
    if leg == 2:
        at cue:
            spawn nest.alien at center
    repeat 10 as k:
        let pos = corners_cw[leg % 4] + headings[leg % 4] * int(k * 62.4)
        at cue:
            spawn (template.den_lizard_weak_slower_0d if k % 2 == 1 else nest.alien) at pos
        cue += gaps[leg]
