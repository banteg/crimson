quest "The Random Factor" version 1
order native
counts native
weapon pistol
terrain (0, 0, 1)

var edges = edge_points()
var trigger = 1500
while trigger < 101500:
    at trigger:
        burst template.alien_random_1d at edges.right copies players * 2 + 4
    at trigger + 200:
        burst template.alien_random_1d at edges.left copies 6
    if int(rand(0x4363df) % 5) == 3:
        at trigger:
            burst template.alien_big_gray_29 at point(edges.bottom.x, arena_size + 64.0) copies players
    trigger += 10000
