quest "Arachnoid Farm" version 1
terrain (2, 3, 2)

# Two rows of spider nests, then a slow line of weak nests across the middle.
let row = players + 4
repeat row as i:
    at 500ms + i * 500ms:
        spawn nest.spider at (256 + i * 102.4, 256)
repeat row as i:
    at 10.5s + i * 500ms:
        spawn nest.spider at (256 + i * 102.4, 768)
repeat players + 7 as i:
    at 40.5s + i * 3.5s:
        spawn template.den_spider_weak_10 at (256 + i * 64, 512)
