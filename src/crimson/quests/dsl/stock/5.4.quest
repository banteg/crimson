quest "The Gang Wars" version 1
terrain (0, 1, 3)

# Alien rings press from one side, then the other; chains climb in from the south between and after.
let west = edge("west", outside=150)
let east = edge("east", outside=150)
let south = edge("south", outside=128)
at 100ms:
    spawn formation.alien_ring at west
at 2.5s:
    spawn formation.alien_ring at east
repeat 10 as i:
    at 5.5s + i * 4s:
        burst formation.alien_ring at east copies 2
at 50.5s:
    spawn template.formation_chain_alien_10_13 at south
repeat 10 as i:
    at 59.5s + i * 4s:
        burst formation.alien_ring at west copies 2
at 107.5s:
    burst template.formation_chain_alien_10_13 at south copies 3
