quest "Monster Blues" version 1
terrain (0, 1, 3)

at 500ms:
    burst template.lizard_random_04 at edge("west", outside=50) copies 10
at 7.5s:
    burst template.alien_random_06 at edge("east", outside=50) copies 10
at 17.5s:
    burst template.spider_sp1_random_03 at edge("south") copies 12
    burst template.spider_sp1_random_03 at edge("north") copies 12

# Then 64 groups from the west, 0.9s apart, cycling through three breeds and growing every eight.
let breeds = [template.alien_random_06, template.spider_sp1_random_03, template.spider_sp2_random_05, template.spider_sp2_random_05]
repeat 64 as i:
    at 27.5s + i * 900ms:
        burst breeds[i % 4] at edge("west") copies i // 8 + 2
