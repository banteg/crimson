quest "Survival Of The Fastest" version 1
weapon submachine_gun
terrain (2, 2, 3)

# A trail of spider nests spirals inward, one every 0.9s; then nests in all four corners.
let trail = [
    line(point(256, 256), point(72, 0), 6),
    line(point(688, 256), point(0, 72), 6),
    line(point(688, 688), point(-72, 0), 4),
    line(point(400, 688), point(0, -72), 4),
    line(point(400, 400), point(72, 0), 2),
]
var cue = 500ms
for segment in trail:
    for pos in segment:
        at cue:
            spawn template.den_spider_weak_10 at pos
        cue += 900ms

at 22.3s:
    spawn template.den_spider_weak_10 at (128, 128)
    spawn nest.alien at (896, 128)
at 24.3s:
    spawn nest.alien at (128, 896)
    spawn template.den_spider_weak_10 at (896, 896)
