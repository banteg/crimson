quest "Lizard Zombie Pact" version 1
order native
counts native
weapon pistol
terrain (6, 7, 6)

var idx = 0

var edges = edge_points()
var trigger = 1500
var wave = 0
while trigger < 113500:
    at trigger:
        burst zombie.random at edges.right copies 6
    at trigger:
        burst zombie.random at edges.left copies 6
    if wave % 5 == 0:
        idx = wave // 5
        at trigger:
            burst template.den_lizard_weak_0c at point(356.0, float(idx * 180 + 256)) copies idx + 1
        at trigger:
            burst template.den_lizard_weak_0c at point(356.0, float(idx * 180 + 384)) copies idx + 2
    trigger += 7000
    wave += 1
