quest "Two Fronts" version 1
terrain (2, 3, 2)

# Aliens from the east and spiders from the west, one each per second; nest pairs land at waves 10, 20 and 30.
repeat 40 as wave:
    at wave * 2s + 1s:
        spawn template.ai1_alien_blue_tint_1a at edge("east")
    at wave * 2s + 2s:
        spawn template.ai1_spider_sp1_blue_tint_1b at edge("west")
    if wave in [10, 20]:
        at wave * 2s + 2.5s:
            spawn nest.spider at (256, 256)
            spawn nest.alien at (768, 768)
    if wave == 30:
        at wave * 2s + 2.5s:
            spawn nest.spider at (768, 256)
            spawn nest.alien at (256, 768)
