quest "The Collaboration" version 1
order native
counts native
weapon pistol
terrain (6, 7, 6)

var count = 0

var edges = edge_points()
var trigger = 1500
var wave = 0
while trigger < 177500:
    count = int(pc24_add(pc24_mul(float(wave), f32(0.8)), 7.0))
    at trigger:
        burst template.ai1_alien_blue_tint_1a at edges.right copies count
    at trigger:
        burst template.ai1_spider_sp1_blue_tint_1b at edges.bottom copies count
    at trigger:
        burst template.ai1_lizard_blue_tint_1c at edges.left copies count
    at trigger:
        burst zombie.random at edges.top copies count
    trigger += 11000
    wave += 1
