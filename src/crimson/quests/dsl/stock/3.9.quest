quest "Deja vu" version 1
order native
counts native
weapon gauss_gun
terrain (4, 4, 5)

var angle = 0

var trigger = 2000
var step = 2000
while step > 560:
    angle = random_angle(rand(0x437946))
    for pos in radial(center, angle, 84, 252, 42):
        at trigger:
            spawn template.den_lizard_weak_slower_0d at pos
    trigger += step
    step -= 80
