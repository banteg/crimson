quest "Deja vu" version 1
weapon gauss_gun
terrain (4, 4, 5)

# Sweep Stakes again, with lizard nests: spokes of four at random angles, the gaps shrinking.
var cue = 2s
repeat 18 as i:
    let angle = rand() % 612 * 0.01
    at cue:
        for radius in range(84, 252, 42):
            spawn template.den_lizard_weak_slower_0d at polar(center, radius, angle)
    cue += 2s - i * 80ms
