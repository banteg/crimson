quest "Army of Three" version 1
terrain (3, 1, 3)

# Three grid formations of each breed sweep in from the west, then two breeds return in force.
at 500ms:
    spawn formation.alien_grid at (-64, 256)
at 5.5s:
    spawn formation.alien_grid at (-64, 512)
at 15s:
    spawn formation.alien_grid at (-64, 768)
at 19.5s:
    spawn formation.spider_grid at (-64, 768)
at 22.5s:
    spawn formation.spider_grid at (-64, 512)
at 26.5s:
    spawn formation.spider_grid at (-64, 256)
at 35.5s:
    spawn formation.lizard_grid at (-64, 256)
at 39.5s:
    spawn formation.lizard_grid at (-64, 512)
at 42.5s:
    spawn formation.lizard_grid at (-64, 768)
at 52.5s:
    burst formation.alien_grid at edge("south", outside=128) copies 3
at 56.5s:
    burst formation.spider_grid at edge("north", outside=256) copies 3
