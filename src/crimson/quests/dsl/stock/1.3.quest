quest "Target Practice" version 1

# Thirty targets around the centre, each facing it; the gaps shrink to 1.1s.
var cue = 2s
repeat 30 as i:
    let angle = rand() % 612 * 0.01
    let pos = polar(center, (rand() % 8 + 2) * 32, angle)
    at cue:
        spawn template.alien_delayed_start_36 at pos heading facing(pos, center)
    cue += max(2s - i * 50ms, 1.1s)
