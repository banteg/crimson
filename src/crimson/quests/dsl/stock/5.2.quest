quest "The Spanking Of The Dead" version 1
terrain (2, 1, 3)

at 500ms:
    spawn template.alien_bonus_carrier_27 at (256, 512)
    spawn template.alien_bonus_carrier_27 at (768, 512)

# 128 zombies spiral in toward the centre, one every 0.3s.
repeat 128 as k:
    let angle = k / 3
    at 5s + k * 300ms:
        spawn zombie.random at polar(center, 512 - k * 3.8, angle) heading angle

at 48.4s:
    burst template.zombie_small_white_42 at edge("east", outside=256) copies 16
at 58.4s:
    burst template.zombie_small_white_42 at edge("west", outside=256) copies 16
