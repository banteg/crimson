quest "Knee-deep in the Dead" version 1
order as-written
terrain (1, 1, 3)

# Zombies shamble in from the west every 1.5s, a brute leads every eighth wave,
# and new lanes open above and below as time goes on.
# as-written: the original lane order; the last lane is listed before an earlier one and can land a frame late.
let west = edge("west", outside=50)
at 100ms:
    spawn template.zombie_const_green_brute_43 at west
repeat 64 as wave:
    let cue = 500ms + wave * 1.5s
    if wave % 8 == 0:
        at cue - 2ms:
            spawn template.zombie_const_green_brute_43 at west
    at cue:
        burst zombie.random at west copies (2 if wave > 32 else 1)
    if cue > 12.5s:
        at cue + 500ms:
            spawn zombie.random at west + point(0, 158)
    if cue > 24.5s:
        at cue + 1s:
            spawn zombie.random at west - point(0, 158)
    if cue > 36.5s:
        at cue + 1.3s:
            spawn template.zombie_small_white_42 at west - point(0, 258)
    if cue > 48.5s:
        at cue + 300ms:
            spawn template.zombie_small_white_42 at west + point(0, 258)
